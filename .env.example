# Copy to .env and fill in. NEVER commit the real .env.
# In Codespaces, prefer repo Settings → Secrets and variables → Codespaces.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-side-only-never-ship-to-a-client

# --- Cloudinary (live media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.org

# --- Semaphore PH (SMS) ---
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# --- Firebase Cloud Messaging (push) ---
FCM_PROJECT_ID=
FCM_SERVER_KEY=

# --- Barangay 183 anchor ---
# Centre of the OSM boundary relation 2988704 (PSGC 1381100183).
# The earlier 14.5419,121.0006 was ~1.2 km north of the barangay.
BARANGAY_LAT=14.51646
BARANGAY_LNG=121.01621
BARANGAY_NAME=Barangay 183, Pasay City

# Cloudinary — complaint photos. Cloud name and preset are public
# by design; they appear in every image URL.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=smartsumbong_unsigned

# Mapillary: street-level imagery for Look around on Spatial Distribution.
# A client token (starts MLY|), read-only; from mapillary.com/dashboard/developers.
# Leave empty and the Look around buttons are not drawn.
MAPILLARY_TOKEN=

# The barangay hall's own phone and opening hours, shown on its safe-point panel.
BARANGAY_HALL_PHONE=
BARANGAY_HALL_HOURS=

# Reference sources for the map toolset (docs/map-data/tools). All optional, none is used by the live site.
# Openverse: https://api.openverse.org/v1/auth_tokens/register/  (free; one email click).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Sketchfab: https://sketchfab.com/settings/password  (API token, free account).
SKETCHFAB_TOKEN=
# Google Programmable Search (image search over the whole web) for the map tools' reference search: an API key (Custom Search API enabled) and the search engine id.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
