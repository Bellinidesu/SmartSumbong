# SmartSumbong admin portal: local configuration.
#
# Copy to .env (git-ignored) and fill in. NEVER commit the real .env: this
# repository is public. On Render the same names are set as environment
# variables (DEPLOY.md lists every one, what it is for, and what happens
# without it). admin/includes/config.php reads them.

# --- Supabase (required) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable (anon) key. Public by design; row-level security guards the data.
# SUPABASE_ANON_KEY is accepted too, for older .env files.
SUPABASE_PUBLISHABLE_KEY=

# --- Cloudinary: complaint photos and video ---
# Cloud name and preset are public by design (they appear in every image URL).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Server-side only: signed uploads, private identity-photo links, Plan and usage.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Street view (Mapillary): "Look around" and the case map's street snapshot ---
# A client token, sent to the browser by design.
MAPILLARY_TOKEN=

# --- Optional ---
# Cloudflare Turnstile site key: turns on the bot check on sign-in pages.
TURNSTILE_SITE_KEY=
# The barangay hall line shown to residents.
BARANGAY_HALL_HOURS=
BARANGAY_HALL_PHONE=
# An https link to the resident app's download page (the Workspace's Report QR widget).
RESIDENT_APP_URL=
# Only on an old host: forward every page to the same path on this address.
PORTAL_MOVED_TO=

# --- One-off scripts only (scripts/privatize-identity-photos.mjs) ---
# Never needed by the portal. Bypasses row-level security: set it in the shell
# for the one run, not here, if you can.
SUPABASE_SERVICE_ROLE_KEY=

# Not set here: the Edge Function secrets (FCM_PROJECT_ID, FCM_CLIENT_EMAIL,
# FCM_PRIVATE_KEY, SEMAPHORE_API_KEY, PUSH_WEBHOOK_SECRET, MEDIA_CLEANUP_SECRET,
# CLOUDINARY_API_KEY/SECRET) live in Supabase -> Edge Functions -> Secrets.
# The 3D map tools on the bellinist branch read their own keys (OPENVERSE_*,
# SKETCHFAB_TOKEN, GOOGLE_CSE_*); main does not use them.
