# SmartSumbong — project-root web-server rules.
#
# Written ahead of real hosting (6 Sep 2026), not for the local `php -S`
# dev server (which ignores .htaccess entirely — this only matters once
# a real Apache host points its document root at this project folder,
# the same layout config.php's own relative paths already assume; see
# that discussion for why).
#
# Confirmed working under the Docker/Apache setup used for the Sep 29-30
# defense deploy (php:8.3-apache, mod_rewrite + AllowOverride All enabled
# in the Dockerfile). Re-verify if the eventual turnover host runs
# something other than Apache 2.4+.
#
# What this defends against: once the document root is this folder, the
# .env file sitting right here (real Supabase keys) would otherwise be
# directly downloadable at https://yourdomain/.env, and things like
# supabase/, mobile/, and this README have no business being served over
# HTTP at all. Only admin/ (behind its own login) and the root landing
# page are meant to answer a request.
#
# public/ (the no-login transparency dashboard) was removed 15 Sep 2026
# (Rose: "we dont need it") -- deliberately dropped from the allowlist
# below along with it, rather than left reachable with nothing behind it.

# Block every dotfile outright — .env, .git, .env.example, etc.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

# Bare domain root -> the small landing page in this folder, so visiting
# the live URL directly doesn't just hit the deny-everything-else rule
# below. (mod_rewrite strips the leading slash before matching, so "/"
# is an empty string here.)
RewriteRule ^$ index.php [L]

# Browsers ask for /favicon.ico on their own; answer with the seal instead
# of the 403 below (it showed as a console error in Lighthouse, 7 Oct 2026).
RewriteRule ^favicon\.ico$ admin/assets/img/favicon-64.png [L]

# Block everything except the two things this project actually serves.
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteCond %{REQUEST_URI} !^/favicon\.ico$
RewriteRule ^ - [F]

# ---------- Speed (7 Oct 2026) ----------
# Compress text on the way out, and let browsers keep static files instead
# of downloading every style, script, font and logo on every page.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/geo+json image/svg+xml
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/geo+json .geojson
<IfModule mod_expires.c>
    # Our own CSS/JS carry ?v=<file time>, so each deploy changes their URL;
    # vendor files, fonts and logos rarely change at all.
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType application/geo+json "access plus 7 days"
</IfModule>

# ---------- Security headers (7 Oct 2026) ----------
# The usual set for a signed-in web app: HTTPS only, no MIME sniffing, no
# framing by other sites, no full URLs leaked to other sites, no camera or
# microphone. (A full Content-Security-Policy is left for after the defense:
# the maps, fonts and inline scripts need a careful allowlist.)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
